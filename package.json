{
  "name": "@red-cup-engineering/sovereign-membrane-admission-service",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "Admits a sovereign membrane for a die already present on disk: binds smart-account-provisioning through its own independently addressed provider CapCell, generates the die's Ed25519 agent-card-signing material, and composes its Agent Card. Never mints chain custody in-process.",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/admit-sovereign-membrane.mjs"
    }
  },
  "bin": {
    "admit-sovereign-membrane": "./scripts/admit-sovereign-membrane.mjs"
  },
  "files": [
    "scripts/",
    "content/",
    "src/",
    "types/"
  ],
  "scripts": {
    "check": "node --check src/admit-sovereign-membrane.mjs && node --check scripts/admit-sovereign-membrane.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@red-cup-engineering/relation-model-notation-json-codec": "0.0.2",
    "@red-cup-engineering/relation-model-notation-typing": "0.0.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/sovereign-membrane-admission-service.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
